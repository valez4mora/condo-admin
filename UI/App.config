<?xml version="1.0" encoding="utf-8"?>

<configuration>

	<startup>
		<supportedRuntime
		  version="v4.0"
		  sku=".NETFramework,Version=v4.8" />
	</startup>

	<appSettings>

		<!-- Parámetros para calcular la cuota de mantenimiento -->
		<add
		  key="TarifaPorM2"
		  value="450" />

		<add
		  key="CargoFijoMantenimiento"
		  value="5000" />

		<!-- API del Ministerio de Hacienda -->
		<add
		  key="URLHacienda"
		  value="https://api.hacienda.go.cr/fe/ae?identificacion=" />

		<!-- Servicio externo de provincias de Costa Rica -->
		<add
		  key="URLProvincias"
		  value="https://raw.githubusercontent.com/lateraluz/Datos/master/provincias.json" />

		<!-- Servicio externo de tipo de cambio USD/CRC -->
		<add
		  key="URLTipoCambio"
		  value="https://open.er-api.com/v6/latest/USD" />

	</appSettings>

	<connectionStrings>

		<add
		  name="CondominioDB"
		  connectionString="Data Source=localhost;Initial Catalog=CondominioDB;Integrated Security=True;"
		  providerName="System.Data.SqlClient" />

	</connectionStrings>

</configuration>