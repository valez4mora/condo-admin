<?xml version="1.0" encoding="utf-8" ?>

<configuration>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<appSettings>

		<!-- API Hacienda -->
		<add
		  key="URLHacienda"
		  value="https://api.hacienda.go.cr/fe/ae?identificacion="
    />

		<!-- Servicio de Provincias -->
		<add
		  key="URLProvincias"
		  value="https://raw.githubusercontent.com/lateraluz/Datos/master/provincias.json"
    />

		<!-- Servicio BCCR -->
		<add
		  key="URLBCCR"
		  value="https://gee.bccr.fi.cr/Indicadores/Suscripciones/WS/wsindicadoreseconomicos.asmx/ObtenerIndicadoresEconomicosXML"
    />

		<add
		  key="NombreBCCR"
		  value="Sistema Condominio"
    />

		<add
		  key="CorreoBCCR"
		  value="TU_CORREO"
    />

		<add
		  key="TokenBCCR"
		  value="TU_TOKEN"
    />

	</appSettings>

	<connectionStrings>

		<add
		  name="CondominioDB"
		  connectionString="Data Source=localhost;Initial Catalog=CondominioDB;Integrated Security=true;"
		  providerName="System.Data.SqlClient"
    />

	</connectionStrings>

</configuration>